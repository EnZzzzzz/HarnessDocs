<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="rsi-learning-loop-v2" name="RSI 自进化闭环架构">
    <mxGraphModel dx="2450" dy="1430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2450" pageHeight="1430" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RSI：以证据驱动的 Design Harness 自进化闭环" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=34;fontStyle=1;fontColor=#213040;" vertex="1" parent="1"><mxGeometry x="150" y="35" width="2030" height="55" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="每轮固定输入条件，执行并保留证据；专家先定义判断，系统再从标注中提炼可验证的 Skill 改动。" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontColor=#637384;" vertex="1" parent="1"><mxGeometry x="150" y="95" width="2070" height="40" as="geometry" /></mxCell>
        <mxCell id="expert_inputs" value="&lt;b&gt;专家标准持续输入&lt;/b&gt;  ｜  设计师：品牌 / 审美 / 体验规范与标注  ｜  工程师：质量文件 / 技术约束 / 可执行检查规则" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2ECF7;strokeColor=#AF98C5;strokeWidth=1.4;fontFamily=Arial;fontSize=17;fontColor=#614D72;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="165" width="2100" height="70" as="geometry" /></mxCell>

        <mxCell id="query" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;01  场景定义与 Query 发现&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;真实需求 / 失败样本 → Query 候选&lt;br&gt;固定回归集 + 探索集，任务单版本化&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：PostgreSQL · Git · 检索 / 筛选&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="150" y="285" width="640" height="270" as="geometry" /></mxCell>
        <mxCell id="execute" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;02  Harness 执行&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Codex / OpenCode / 内部 Agent 接入&lt;br&gt;注入 Skill 与质量文件；隔离运行、限时&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：CLI · Hook · Plugin · 容器 · OTel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="880" y="285" width="640" height="270" as="geometry" /></mxCell>
        <mxCell id="snapshot" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;03  采集与冻结运行快照&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;收集事件 / Git 差异 / 截图 / 日志，校验去重&lt;br&gt;冻结不可变 Run；后补标注引用 Run ID&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：OBS · PostgreSQL · Git · 摘要校验&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="1610" y="285" width="640" height="270" as="geometry" /></mxCell>

        <mxCell id="sample_contract" value="&lt;b&gt;贯穿全环的样本契约&lt;/b&gt;  ｜  Query 版本 · Run ID · Harness / 模型 / 环境 · Skill commit · 产物摘要 · 标注引用 · 评测结论" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#D8B579;strokeWidth=1.3;fontFamily=Arial;fontSize=16;fontColor=#785A31;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="625" width="1420" height="90" as="geometry" /></mxCell>

        <mxCell id="update" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;06  Skill 更新与发布&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;修改规则 / 保存父版本与差异&lt;br&gt;先生成候选；下轮评测后晋升或回退&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：Git · PR / CI · 发布记录&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="150" y="785" width="640" height="270" as="geometry" /></mxCell>
        <mxCell id="extract" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;05  经验提取与总结&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;聚合重复问题与反例，形成规则候选&lt;br&gt;记录证据、适用范围和人审结论&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：批处理 / LLM · SQL · Iceberg（二期）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="880" y="785" width="640" height="270" as="geometry" /></mxCell>
        <mxCell id="annotate" value="&lt;span style=&quot;font-size:23px&quot;&gt;&lt;b&gt;04  专家标注与对照评测&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;设计师标注产物 / 理由；工程师审质量&lt;br&gt;固定用例前后对照 + 自动质量门禁&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#56718A&quot;&gt;技术候选：标注台 · ESLint / TS · Playwright / axe&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F9FD;strokeColor=#789DBF;strokeWidth=1.8;fontFamily=Arial;fontSize=18;fontColor=#243F58;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="1610" y="785" width="640" height="270" as="geometry" /></mxCell>

        <mxCell id="foundation" value="&lt;b&gt;横切技术底座&lt;/b&gt;  ｜  身份 / 项目隔离：OIDC / SSO · RBAC · 审计  ｜  可观测：OpenTelemetry  ｜  业务元数据：PostgreSQL  ｜  文件：OBS  ｜  文本版本：Git  ｜  分析：OBS + Iceberg + 查询引擎（二期）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#A9B2B9;strokeWidth=1.2;fontFamily=Arial;fontSize=16;fontColor=#596771;align=center;verticalAlign=middle;spacingLeft=20;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="150" y="1145" width="2100" height="105" as="geometry" /></mxCell>
        <mxCell id="note" value="架构讨论稿 v2 · 技术均为候选而非已实现；初期由设计师 / 工程师提供评判，自动评测与湖仓分析随数据成熟逐步引入。" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=15;fontColor=#73808B;" vertex="1" parent="1"><mxGeometry x="150" y="1280" width="2110" height="45" as="geometry" /></mxCell>

        <mxCell id="flow_01_02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#638EAE;strokeWidth=2.5;endArrow=block;endSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="query" target="execute"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_02_03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#638EAE;strokeWidth=2.5;endArrow=block;endSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="execute" target="snapshot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_03_04" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#638EAE;strokeWidth=2.5;endArrow=block;endSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="snapshot" target="annotate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_04_05" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#638EAE;strokeWidth=2.5;endArrow=block;endSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="annotate" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_05_06" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#638EAE;strokeWidth=2.5;endArrow=block;endSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="extract" target="update"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_06_01" value="下一轮：同一回归集 + 新探索集" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C77F3F;strokeWidth=2.7;endArrow=block;endSize=9;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#A16B37;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="update" target="query"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65" y="920" /><mxPoint x="65" y="420" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
